# Database
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_control
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_ADMIN_USER=postgres
TENANT_DB_ADMIN_PASSWORD=postgres

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Platform
PLATFORM_ROOT_DOMAIN=127-0-0-1.nip.io
API_PORT=3000
API_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_TEST_SECRET_KEY=sk_test_dummy
STRIPE_TEST_PUBLIC_KEY=pk_test_dummy

# Environment
NODE_ENV=development
